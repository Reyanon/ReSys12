	if (h == dispatch_01c0) { *j = 1; *base = 0xe0000; return 1; }
	if (h == dispatch_01d0) { *j = 1; *base = 0xf0000; return 1; }
	if (h == dispatch_01f0) { *j = 1; *base = 0x110000; return 1; }
	if (h == dispatch_7800) { *j = 1; *base = 0x160000; return 1; }
	if (h == dispatch_7b5c) { *j = 1; *base = 0x170000; return 1; }
	if (h == dispatch_7bd4) { *j = 1; *base = 0x180000; return 1; }
	if (h == dispatch_7c00) { *j = 1; *base = 0x190000; return 1; }
