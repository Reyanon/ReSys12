{
	if (h == dispatch_0100) { *j = 1; *base = 0x20000; return 1; }
	if (h == dispatch_01007800) { *j = 2; *base = 0x30000; return 1; }
	if (h == dispatch_0140) { *j = 1; *base = 0x70000; return 1; }
