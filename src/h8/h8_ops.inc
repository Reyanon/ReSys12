static void state_reset(void)
{
	h8.CCR |= (1 ? F_I : F_H);
	h8.EXR = EXR_I | EXR_NC;
	if(1) {
		h8.IR[0] = read16i(0);
		h8.IR[1] = read16i(2);
		h8.PC = (h8.IR[0] << 16) | h8.IR[1];
	} else {
		h8.PC = read16i(0);
	}
	update_irq_filter();
	h8.NPC = h8.PC & 0xffffff;
	h8.PIR = read16i(h8.PC);
	h8.PC += 2;
	prefetch_done_noirq();
}

static void state_irq(void)
{
	internal(1);
	h8.TMP1 = r32_r(7) - 2;
	r32_w(7, h8.TMP1);
	write16(h8.TMP1, h8.NPC);
	h8.TMP1 = r32_r(7) - 2;
	r32_w(7, h8.TMP1);
	write16(h8.TMP1, (h8.CCR << 8) | ((h8.NPC >> 16) & 0xff));
	if(exr_in_stack()) {
		h8.TMP1 = r32_r(7) - 2;
		r32_w(7, h8.TMP1);
		write16(h8.TMP1, h8.EXR << 8);
	}
	debugger_exception_hook(h8.taken_irq_vector);
	if(1) {
		h8.IR[0] = read16i(4*h8.taken_irq_vector);
		h8.IR[1] = read16i(4*h8.taken_irq_vector+2);
		h8.PC = (h8.IR[0] << 16) | h8.IR[1];
	} else {
		h8.PC = read16i(2*h8.taken_irq_vector);
	}
	internal(1);
	irq_setup();
	update_irq_filter();
	interrupt_taken();
	h8.NPC = h8.PC & 0xffffff;
	h8.PIR = read16i(h8.PC);
	h8.PC += 2;
	prefetch_done_noirq();
}

