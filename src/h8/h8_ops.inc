		case 0x01: {
			switch(h8.inst_state & 0xff) {
			case 0x00: dispatch_0100(); break;
			case 0x40: dispatch_0140(); break;
			case 0x80: op_sleep(); break;
			case 0xc0: dispatch_01c0(); break;
			case 0xd0: dispatch_01d0(); break;
