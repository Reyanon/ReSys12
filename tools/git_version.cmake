# Generate a version header from git on every build (shown in Options About, same rules as Reirem tools/git_version.cmake).
# usage: cmake -DSRC=<repo root> -DOUT=<rs12_version.h> -P tools/git_version.cmake
# version = last tag vX.Y.Z + N commits since: vX.Y.(Z+N) (last digit goes up with every commit even without a new tag).
# Without a tag, v0.1.<total commit count>. -dirty if there are uncommitted changes.
# Do not rewrite the file if the content is unchanged (avoids recompiles)

if(NOT SRC OR NOT OUT)
  message(FATAL_ERROR "git_version: SRC and OUT are required")
endif()

set(VER "unknown")
set(DATE "")
find_package(Git QUIET)
if(GIT_FOUND)
  execute_process(COMMAND "${GIT_EXECUTABLE}" describe --tags --match "v[0-9]*" --long --dirty
    WORKING_DIRECTORY "${SRC}" OUTPUT_VARIABLE OUTV RESULT_VARIABLE RC
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(RC EQUAL 0 AND OUTV MATCHES "^v([0-9]+)\\.([0-9]+)\\.([0-9]+)-([0-9]+)-g[0-9a-f]+(-dirty)?$")
    math(EXPR PATCH "${CMAKE_MATCH_3} + ${CMAKE_MATCH_4}")
    set(VER "v${CMAKE_MATCH_1}.${CMAKE_MATCH_2}.${PATCH}${CMAKE_MATCH_5}")
  else()
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-list --count HEAD
      WORKING_DIRECTORY "${SRC}" OUTPUT_VARIABLE OUTN RESULT_VARIABLE RC
      OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(RC EQUAL 0)
      execute_process(COMMAND "${GIT_EXECUTABLE}" diff --quiet HEAD
        WORKING_DIRECTORY "${SRC}" RESULT_VARIABLE DIRTY ERROR_QUIET)
      set(VER "v0.1.${OUTN}")
      if(NOT DIRTY EQUAL 0)
        set(VER "${VER}-dirty")
      endif()
    endif()
  endif()
  execute_process(COMMAND "${GIT_EXECUTABLE}" log -1 --format=%cd --date=short
    WORKING_DIRECTORY "${SRC}" OUTPUT_VARIABLE OUTD RESULT_VARIABLE RC
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(RC EQUAL 0)
    set(DATE "${OUTD}")
  endif()
endif()

set(TEXT "// generated by tools/git_version.cmake at build time\n#define RS12_VERSION \"${VER}\"\n#define RS12_VERSION_DATE \"${DATE}\"\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" OLD)
endif()
if(NOT OLD STREQUAL TEXT)
  file(WRITE "${OUT}" "${TEXT}")
endif()
